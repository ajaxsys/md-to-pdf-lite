{
  "name": "md-to-pdf-lite",
  "version": "1.0.0",
  "description": "Ultra-lightweight, zero-chromium-bundle Markdown to PDF engine with CJK typography. Bridging the last mile from AI Markdown output to polished client deliverables.",
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "docs",
    "README*.md"
  ],
  "bin": {
    "md-to-pdf-lite": "bin/cli.js",
    "md2pdf-lite": "bin/cli.js"
  },
  "keywords": [
    "markdown",
    "pdf",
    "markdown-to-pdf",
    "md-to-pdf",
    "puppeteer",
    "puppeteer-core",
    "mermaid",
    "cjk",
    "katex",
    "cli",
    "lightweight"
  ],
  "author": "ajaxsys",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaxsys/md-to-pdf-lite.git"
  },
  "bugs": {
    "url": "https://github.com/ajaxsys/md-to-pdf-lite/issues"
  },
  "homepage": "https://github.com/ajaxsys/md-to-pdf-lite#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "test": "node test/run-tests.js",
    "test:e2e": "node test/run-e2e.js",
    "test:all": "node test/run-tests.js && node test/run-e2e.js"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "commander": "^13.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "picocolors": "^1.1.1",
    "puppeteer-core": "^24.4.0"
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5"
  }
}
