# ==============================================================================
# md-to-pdf-lite: Environment Variables Configuration Sample
# Copy this file to .env and configure your secrets before deployment.
# NEVER commit the actual .env file to public Git repositories!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS & Lambda Deployment Configuration
# ------------------------------------------------------------------------------
AWS_REGION=ap-northeast-1

# Lambda Resource Allocation (Recommended: 1536 MB, ~0.87 vCPU)
LAMBDA_MEMORY_SIZE=1536
LAMBDA_TIMEOUT=60

# ------------------------------------------------------------------------------
# 2. Dual-Channel Security & Anti-Bot Protection
# ------------------------------------------------------------------------------

# [Channel A: Developer / CLI Private Key]
# Keep this secret! When supplied via 'x-api-key: <key>', all Proof-of-Work checks
# and rate limits are completely bypassed. Ideal for local curl, scripts, and CI/CD.
PRIVATE_API_KEY=your_private_secret_key_here_for_curl_and_cli

# [Channel B: Web Studio Proof-of-Work (PoW) Configuration]
# Provides zero-dependency, asymmetric client-side computational defense:
# - Browser client spends ~60-90ms solving a challenge (invisible during export).
# - Lambda server verifies it in 0.02ms.
# - Replay window: 120 seconds.
# POW_DIFFICULTY: Number of leading hexadecimal zeros (default: 4, ~65,000 hashes)
POW_DIFFICULTY=4

# Shared salt for Proof-of-Work challenge generation
WEB_CLIENT_SALT=md2pdf_lite_salt_v1

# ------------------------------------------------------------------------------
# 3. Web Studio Frontend (Vite)
# ------------------------------------------------------------------------------
# (Optional) If you want the Web Studio build to always include your private API key:
# VITE_API_KEY=your_private_secret_key_here_for_curl_and_cli
VITE_POW_DIFFICULTY=4
VITE_WEB_CLIENT_SALT=md2pdf_lite_salt_v1

# ------------------------------------------------------------------------------
# 4. Infrastructure & Pulumi Backend (Optional)
# ------------------------------------------------------------------------------
# Self-hosted S3 state backend URL. If omitted, uses default Pulumi login (cloud or local).
# Example: PULUMI_BACKEND_URL=s3://my-unique-pulumi-state-bucket?region=ap-northeast-1
# PULUMI_BACKEND_URL=
# PULUMI_STACK=dev
